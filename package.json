{
	"name": "e-glosowanie-prototyp",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --port 5173",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --port 4173",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"format": "biome format --write",
		"test": "vitest run",
		"e2e": "playwright test",
		"e2e:ci": "playwright test --ignore-snapshots"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"@tailwindcss/oxide"
		]
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.46",
		"devices.css": "0.2.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.3",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^30.1.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
